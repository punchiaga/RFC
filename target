# Cell 13: Validate RFC target distribution

from pyspark.sql import functions as F

rfc_df.groupBy("target").agg(
    F.count("*").alias("record_count"),
    F.min("days_from_snapshot_to_first_event").alias("min_days"),
    F.max("days_from_snapshot_to_first_event").alias("max_days")
).orderBy("target").show()

# Cell 15: Inspect target distribution across snapshots

from pyspark.sql import functions as F

snapshot_summary = (
    rfc_df
    .groupBy(F.to_date("effective_dttm").alias("snapshot_date"))
    .agg(
        F.count("*").alias("total_records"),
        F.sum(F.col("target").cast("long")).alias("positive_records")
    )
    .withColumn(
        "positive_rate_pct",
        F.round(
            F.col("positive_records") / F.col("total_records") * 100,
            2
        )
    )
    .orderBy("snapshot_date")
)

display(snapshot_summary)

# Cell 16: Check target observation window

from pyspark.sql import functions as F

rfc_df.groupBy(
    F.to_date("effective_dttm").alias("snapshot_date")
).agg(
    F.max("target_first_event_date").alias("latest_event_date"),
    F.max("days_from_snapshot_to_first_event").alias("max_days"),
    F.sum(
        F.when(
            (F.col("target") == 1) &
            (F.col("days_from_snapshot_to_first_event") > 90),
            1
        ).otherwise(0)
    ).alias("positives_after_90_days")
).orderBy("snapshot_date").show(12, truncate=False)

# Cell 17: Check whether target labels align with event timing

from pyspark.sql import functions as F

rfc_df.agg(
    F.sum(
        F.when(
            (F.col("target") == 1) &
            F.col("target_first_event_date").isNull(),
            1
        ).otherwise(0)
    ).alias("positive_missing_event_date"),

    F.sum(
        F.when(
            (F.col("target") == 0) &
            F.col("target_first_event_date").isNotNull(),
            1
        ).otherwise(0)
    ).alias("negative_with_event_date"),

    F.sum(
        F.when(
            (F.col("target") == 1) &
            (
                F.col("days_from_snapshot_to_first_event").isNull() |
                (F.col("days_from_snapshot_to_first_event") < 0)
            ),
            1
        ).otherwise(0)
    ).alias("positive_invalid_event_days")
).show()
