# Cell 13: Validate RFC target distribution

from pyspark.sql import functions as F

rfc_df.groupBy("target").agg(
    F.count("*").alias("record_count"),
    F.min("days_from_snapshot_to_first_event").alias("min_days"),
    F.max("days_from_snapshot_to_first_event").alias("max_days")
).orderBy("target").show()
