
def prepare_pandas_batch(
    df: DataFrame,
    feature_columns: list[str] | None = None,
) -> tuple[pd.DataFrame, np.ndarray]:

    if feature_columns is None:
        feature_columns = active_feature_columns

    batch_pdf = (
        prepare_rfc_features(df)
        .select(*feature_columns, "target")
        .toPandas()
    )

    X_batch = batch_pdf[feature_columns].copy()
    y_batch = batch_pdf["target"].to_numpy(dtype=np.int8)

    selected_numeric_columns = [
        col for col in numeric_pipeline_columns
        if col in feature_columns
    ]

    for column in selected_numeric_columns:
        X_batch[column] = (
            pd.to_numeric(X_batch[column], errors="coerce")
            .astype(np.float32)
        )

    selected_onehot_columns = [
        col for col in onehot_columns
        if col in feature_columns
    ]

    remaining_object_columns = set(
        X_batch.select_dtypes(include=["object"]).columns
    )

    assert remaining_object_columns == set(selected_onehot_columns), (
        "Unexpected object columns: "
        f"{sorted(remaining_object_columns - set(selected_onehot_columns))}"
    )

    return X_batch, y_batch

