# Cell 10: RFC dataset configuration

RFC_CONFIG = {
    "catalog": "YOUR_CATALOG",
    "schema": "YOUR_SCHEMA",
    "table": "YOUR_RFC_TABLE",
    "sample_size": 10000,
    "random_seed": 42
}

RFC_TABLE_PATH = (
    f"{RFC_CONFIG['catalog']}."
    f"{RFC_CONFIG['schema']}."
    f"{RFC_CONFIG['table']}"
)

print("RFC source table:", RFC_TABLE_PATH)
print("Sample size:", RFC_CONFIG["sample_size"])
print("Random seed:", RFC_CONFIG["random_seed"])


# Cell 11: Validate source table configuration

required_keys = ["catalog", "schema", "table"]

for key in required_keys:
    value = RFC_CONFIG[key].strip()
    assert value and not value.startswith("YOUR_"), (
        f"Please configure the actual RFC {key}."
    )

RFC_TABLE_PATH = (
    f"{RFC_CONFIG['catalog']}."
    f"{RFC_CONFIG['schema']}."
    f"{RFC_CONFIG['table']}"
)

print("RFC table:", RFC_TABLE_PATH)
print("Table exists:", spark.catalog.tableExists(RFC_TABLE_PATH))

# Cell 12: Load and inspect RFC source data

rfc_df = spark.table(RFC_TABLE_PATH)

print("Number of columns:", len(rfc_df.columns))
print("\nColumn names and data types:")
rfc_df.printSchema()

print("\nFirst 5 records:")
display(rfc_df.limit(5))
