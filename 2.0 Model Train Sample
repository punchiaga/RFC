# DBTITLE 1,Negatgive sampling - Train
# hash policy_id + effective_dttm here

from pyspark.sql import functions as F


schema = "bdp4_prod_ml_build.hi_customer_right_fit_cover_data"

train_table = (
    f"{schema}.rfc_training_20261020105807_train"
)

sampled_train_table = (
    f"{schema}.rfc_training_20261020105807_train_sampled"
)

# Secondary sampling configuration
sampling_salt = 42
bucket_count = 10000
negative_threshold = 500   # 500 / 10000 = ~5% or 1500/10000 ~15% 


# Read master Train population
train_df = spark.table(train_table)


# Keep all positive observations
positives = (
    train_df
    .filter(F.col("target") == 1)
)


# Deterministically retain ~5% of negative observations
negatives = (
    train_df
    .filter(F.col("target") == 0)
    .withColumn(
        "_sample_bucket",
        F.pmod(
            F.xxhash64(
                F.col("policy_id"),
                F.col("effective_dttm"),
                F.lit(sampling_salt)
            ),
            F.lit(bucket_count)
        )
    )
    .filter(F.col("_sample_bucket") < negative_threshold)
    .drop("_sample_bucket")
)


# Combine all positives with sampled negatives
sampled_train_df = (
    positives
    .unionByName(negatives)
)


# Persist as a separate modelling table
(
    sampled_train_df
    .write
    .format("delta")
    .mode("overwrite")
    .saveAsTable(sampled_train_table)
)

print(f"Created: {sampled_train_table}")

