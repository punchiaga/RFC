# MAGIC %md
# MAGIC 1. Split policies deterministically: Assign each distinct policy_id to Train / Validation / Test using a fixed hash. This prevents policy leakage and makes the split reproducible.
# MAGIC
# MAGIC 2. Restore all snapshots: Join the assigned policy_ids back to the full RFC source so each policy retains all associated effective_dttm snapshots.
# MAGIC
# MAGIC 3. Validate the split: Confirm zero policy_id overlap across datasets, no source rows are lost, the monthly distributions are sensible, and reruns produce the same assignments.

# COMMAND ----------

from pyspark.sql import functions as F

schema = "bdp4_prod_ml_build.hi_customer_right_fit_cover_data"

source_table = (
    f"{schema}.rfc_training_20261020105807_test_1_NS"
)

# One record per policy
policy_ids = (
    spark.table(source_table)
    .select("policy_id")
    .where(F.col("policy_id").isNotNull())
    .distinct()
)

# Deterministic policy-level split
policy_split = (
    policy_ids
    .withColumn(
        "split_bucket",
        F.pmod(
            F.xxhash64(
                F.col("policy_id"),
                F.lit(42)
            ),
            F.lit(10000)
        )
    )
    .withColumn(
        "dataset",
        F.when(F.col("split_bucket") < 8100, "train")
         .when(F.col("split_bucket") < 9000, "validation")
         .otherwise("test")
    )
)

display(
    policy_split
    .groupBy("dataset")
    .agg(F.count("*").alias("policies"))
    .orderBy("dataset")
)


# COMMAND ----------

# MAGIC %md
# MAGIC ### Step 2: Bring back all snapshots

# COMMAND ----------

# This preserves every source snapshot belonging to each assigned policy.

source_df = spark.table(source_table)

split_df = (
    source_df
    .join(
        policy_split.select("policy_id", "dataset"),
        on="policy_id",
        how="inner"
    )
)

train_df = split_df.filter(F.col("dataset") == "train").drop("dataset")
validation_df = split_df.filter(F.col("dataset") == "validation").drop("dataset")
test_df = split_df.filter(F.col("dataset") == "test").drop("dataset")

# COMMAND ----------

from pyspark.sql import functions as F

# 1. Row and distinct policy counts
for name, df in [
    ("train", train_df),
    ("validation", validation_df),
    ("test", test_df),
]:
    result = df.agg(
        F.count("*").alias("rows"),
        F.countDistinct("policy_id").alias("policies")
    )

    print(name)
    result.show()


# 2. Check policy leakage between datasets
train_val_overlap = (
    train_df.select("policy_id").distinct()
    .join(
        validation_df.select("policy_id").distinct(),
        "policy_id",
        "inner"
    )
    .count()
)

train_test_overlap = (
    train_df.select("policy_id").distinct()
    .join(
        test_df.select("policy_id").distinct(),
        "policy_id",
        "inner"
    )
    .count()
)

val_test_overlap = (
    validation_df.select("policy_id").distinct()
    .join(
        test_df.select("policy_id").distinct(),
        "policy_id",
        "inner"
    )
    .count()
)

print("Train / Validation overlap:", train_val_overlap)
print("Train / Test overlap:", train_test_overlap)
print("Validation / Test overlap:", val_test_overlap)


# 3. Confirm no source rows were lost
source_rows = spark.table(source_table).count()

split_rows = (
    train_df.count()
    + validation_df.count()
    + test_df.count()
)

print("Source rows:", source_rows)
print("Split rows:", split_rows)
print("Rows match:", source_rows == split_rows)

