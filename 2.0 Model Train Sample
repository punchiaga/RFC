    spark.table(validation_table)
)

(
    sampled_validation_df
    .write
    .format("delta")
    .mode("overwrite")
    .saveAsTable(sampled_validation_table)
)


# Test: deterministic ~30% of ALL rows
sampled_test_df = deterministic_sample(
    spark.table(test_table)
)

(
    sampled_test_df
    .write
    .format("delta")
    .mode("overwrite")
    .saveAsTable(sampled_test_table)
