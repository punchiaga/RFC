from pyspark.sql import functions as F

schema = "bdp4_prod_ml_build.hi_customer_right_fit_cover_data"

train_table = f"{schema}.rfc_training_20261020105807_train"
sampled_train_table = f"{schema}.rfc_training_20261020105807_train_sampled"

sampling_salt = 42
bucket_count = 10000
negative_threshold = 500

train = spark.table(train_table)
sampled = spark.table(sampled_train_table)


# 1. Compare target counts
print("MASTER TRAIN")
train.groupBy("target").count().orderBy("target").show()

print("SAMPLED TRAIN")
sampled.groupBy("target").count().orderBy("target").show()


# 2. Verify all positives were retained
master_positives = train.filter(F.col("target") == 1).count()
sampled_positives = sampled.filter(F.col("target") == 1).count()

print("Master positives:", master_positives)
print("Sampled positives:", sampled_positives)
print("All positives retained:", master_positives == sampled_positives)


# 3. Check realised negative sampling percentage
master_negatives = train.filter(F.col("target") == 0).count()
sampled_negatives = sampled.filter(F.col("target") == 0).count()

negative_pct = sampled_negatives / master_negatives * 100

print("Master negatives:", master_negatives)
print("Sampled negatives:", sampled_negatives)
print(f"Negative sampling rate: {negative_pct:.4f}%")


# 4. Recreate deterministic expected sample
expected = (
    train
    .withColumn(
        "_sample_bucket",
        F.pmod(
            F.xxhash64(
                F.col("policy_id"),
                F.col("effective_dttm"),
                F.lit(sampling_salt)
            ),
            F.lit(bucket_count)
        )
    )
    .filter(
        (F.col("target") == 1)
        |
        (
            (F.col("target") == 0)
            & (F.col("_sample_bucket") < negative_threshold)
        )
    )
    .drop("_sample_bucket")
)


# Compare observation keys
key_columns = [
    "policy_id",
    "effective_dttm",
    "target"
]

differences = (
    expected.select(*key_columns)
    .exceptAll(sampled.select(*key_columns))
    .unionByName(
        sampled.select(*key_columns)
        .exceptAll(expected.select(*key_columns))
    )
    .count()
)

print("Assignment differences:", differences)
print("Deterministic sample reproduced:", differences == 0)

