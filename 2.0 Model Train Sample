from pyspark.sql import functions as F

schema = "bdp4_prod_ml_build.hi_customer_right_fit_cover_data"

source_table = f"{schema}.rfc_training_20261020105807_test_1_NS"
train_table = f"{schema}.rfc_training_20261020105807_train"
validation_table = f"{schema}.rfc_training_20261020105807_validation"
test_table = f"{schema}.rfc_training_20261020105807_test"


# Recreate assignment using the SAME hash logic and seed
rerun_split = (
    spark.table(source_table)
    .select("policy_id")
    .distinct()
    .withColumn(
        "split_bucket",
        F.pmod(
            F.xxhash64(
                F.col("policy_id"),
                F.lit(42)
            ),
            F.lit(10000)
        )
    )
    .withColumn(
        "dataset",
        F.when(F.col("split_bucket") < 8100, "train")
         .when(F.col("split_bucket") < 9000, "validation")
         .otherwise("test")
    )
    .select("policy_id", "dataset")
)


# Actual assignment from persisted tables
saved_split = (
    spark.table(train_table)
    .select("policy_id")
    .distinct()
    .withColumn("dataset", F.lit("train"))

    .unionByName(
        spark.table(validation_table)
        .select("policy_id")
        .distinct()
        .withColumn("dataset", F.lit("validation"))
    )

    .unionByName(
        spark.table(test_table)
        .select("policy_id")
        .distinct()
        .withColumn("dataset", F.lit("test"))
    )
)


# Compare expected vs persisted assignment
differences = (
    rerun_split
    .exceptAll(saved_split)
    .unionByName(
        saved_split.exceptAll(rerun_split)
    )
    .count()
)

print("Assignment differences:", differences)
print("Deterministic split reproduced:", differences == 0)

