    return (
        df
        .withColumn(
            "_sample_bucket",
            F.pmod(
                F.xxhash64(
                    F.col("policy_id"),
                    F.col("effective_dttm"),
                    F.lit(sampling_salt)
                ),
                F.lit(bucket_count)
            )
        )
        .filter(F.col("_sample_bucket") < sample_threshold)
        .drop("_sample_bucket")
    )


# Validation: deterministic ~30% of ALL rows
